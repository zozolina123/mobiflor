# Copy to .env.local for local overrides. On Vercel, set these under Project → Settings → Environment Variables.

# The site's real address, without a trailing slash (e.g. https://www.mobiflor.ro).
# Used for canonical URLs, the sitemap, structured data and social share images.
# Leave it unset while the site is a draft: the Vercel address is used instead and
# search engines are asked not to index the site. Setting it turns indexing on.
NEXT_PUBLIC_SITE_URL=
